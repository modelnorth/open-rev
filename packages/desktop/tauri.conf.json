{
  "build": {
    "beforeDevCommand": "npm run dev --workspace=@openrev/ui",
    "beforeBuildCommand": "npm run build --workspace=@openrev/ui",
    "devPath": "http://localhost:3000",
    "distDir": "../ui/dist"
  },
  "package": {
    "productName": "OpenRev",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "scope": ["$APPData/**", "$DESKTOP/**", "$DOCUMENT/**"]
      },
      "process": {
        "relaunch": true
      },
      "shell": {
        "all": true,
        "execute": true,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "Apache-2.0",
      "identifier": "com.openrev.desktop",
      "icon": ["icons/icon.png"]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "OpenRev – Unified Software Intelligence Platform",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}

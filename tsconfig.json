{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/sdk/src/**/*.ts",
    "packages/plugin-sdk/src/**/*.ts",
    "packages/provider-sdk/src/**/*.ts",
    "packages/marketplace/src/**/*.ts",
    "packages/adapters/**/*.ts",
    "packages/providers/**/*.ts",
    "tests/**/*.ts",
    "bin/**/*.js"
  ]
}

{
  "build": {
    "beforeDevCommand": "npm run dev --workspace=@openrev/ui",
    "beforeBuildCommand": "npm run build --workspace=@openrev/ui",
    "devPath": "http://localhost:3000",
    "distDir": "../../ui/dist"
  },
  "package": {
    "productName": "OpenRev",
    "version": "0.1.0-alpha.2"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "Apache-2.0",
      "identifier": "com.openrev.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.png"
      ]
    },
    "windows": [
      {
        "title": "OpenRev – Unified Software Intelligence Platform",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
